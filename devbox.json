{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.25.4",
    "golangci-lint@2.6.2",
    "yamlfmt@0.20.0",
    "treefmt@2.4.0",
    "formatjson5@0.2.6",
    "zizmor@1.16.3",
    "mado@0.3.0",
    "toml-sort@0.24.3",
    "tombi@0.6.40"
  ],
  "shell": {
    "scripts": {
      "build": "CGO_ENABLE=0 go build -o go-covimerage ./cmd/go-covimerage",
      "test": "go test -v ./...",
      "fmt": "treefmt",
      "check": [
        "golangci-lint run ./...",
        "zizmor .github",
        "mado check"
      ]
    }
  }
}
